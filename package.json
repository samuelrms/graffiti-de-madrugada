{
  "name": "graffiti-de-madrugada",
  "version": "2.0.0",
  "private": true,
  "description": "Jogo multiplayer 3D competitivo de graffiti no navegador",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch src/server/index.ts\" \"vite --port 5173\"",
    "build": "pnpm build:server && pnpm build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test test/city.test.ts test/server.test.ts",
    "test:e2e": "tsx --test test/e2e.test.ts",
    "screenshots": "tsx tools/screenshots.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/three": "^0.181.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "lucide": "^0.511.0",
    "puppeteer-core": "^25.8.0",
    "socket.io-client": "^4.8.1",
    "three": "^0.181.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^7.0.0"
  },
  "type": "module"
}
